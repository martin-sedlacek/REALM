#!/bin/bash
# go <logname> <script> [args...]
#
# Run a script inside the held Slurm allocation, teeing everything to
# tmp/interactive/logs/<logname>.log and finishing with an explicit EXIT marker.
#
# Exists because passing multi-line command strings through `srun --overlap bash -c '...'`
# collapsed the newlines and produced a mangled single command that ran silently for a minute
# before anyone noticed. Everything executable goes in a file now.
#
#   ./scripts/clara/interactive/go inc_on ./scripts/clara/interactive/t2_inc_on.sh
#
# ALLOC is the job id of the interactive allocation.

set -uo pipefail

ALLOC=${ALLOC:-190155}
# Paths from lib/paths.sh, derived from this script's own location -- never from the profile's
# exported $REALM_ROOT, which names the pre-port 1.1.1 checkout. See that file's header. This also
# fixes the --chdir below: hardcoded, it sent a worktree's `go` into the MAIN checkout, so the run
# executed the shared tree's code while the worktree's edits sat unused.
source "$(dirname "${BASH_SOURCE[0]}")/../lib/paths.sh"
# A failed `source` is not fatal by itself (no set -e), and $REALM_ROOT would then hold the
# value the shell profile exports -- the PRE-PORT 1.1.1 checkout -- so this run would silently
# evaluate the wrong tree. paths.sh sets REALM_PATHS_SH last and does not export it.
[ "${REALM_PATHS_SH:-}" = 1 ] || { echo "ERROR: could not source scripts/clara/lib/paths.sh" >&2; exit 1; }
ROOT=$REALM_ROOT
LOGDIR=$ROOT/tmp/interactive/logs

[ $# -ge 2 ] || { echo "usage: go <logname> <script> [args...]" >&2; exit 2; }
NAME=$1; shift

mkdir -p "$LOGDIR"
LOG=$LOGDIR/$NAME.log

squeue -h -j "$ALLOC" -o "%T" | grep -q RUNNING || {
  echo "go: allocation $ALLOC is not RUNNING" >&2; exit 1; }

# `sed -i` rewrites a file and drops its mode, so an edited script silently loses +x and srun dies
# with a bare "Permission denied" / exit 13 that looks nothing like the real cause. Catch it here.
if [ -f "$1" ] && [ ! -x "$1" ]; then
  echo "go: $1 is not executable (sed -i drops the mode -- chmod 755 it)" >&2; exit 1
fi

{
  echo "### go: $NAME"
  echo "### started: $(date -Is)"
  echo "### cmd: $*"
  echo "### alloc: $ALLOC"
} > "$LOG"

srun --jobid="$ALLOC" --overlap --chdir="$ROOT" "$@" >> "$LOG" 2>&1
EXIT=$?
echo "### EXIT_CODE=$EXIT" >> "$LOG"
echo "### finished: $(date -Is)" >> "$LOG"
echo "go: $NAME exited $EXIT (log: $LOG)"
exit $EXIT
