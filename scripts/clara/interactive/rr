#!/bin/bash
# rr -- run a command inside the REALM og391 container on an already-held Slurm allocation.
#
# Replaces the `docker exec realm_stock` / `docker exec realm_oglite` loop from the retired
# workstation. Same two conditions, expressed as a bind rather than two containers:
#
#   MODE=stock    image's own OmniGibson 3.9.1 at /behavior-src/OmniGibson  (default)
#   MODE=oglite   host OG-lite_og391/omnigibson bound over the image's package
#   MODE=stockfix image's own OmniGibson plus the patched files under $STOCK_PATCH, bound
#                 individually. This is what the rebuilt SIF ships -- both build recipes apply the
#                 same patches, so stockfix and a rebuilt image behave identically.
#                 Run scripts/clara/interactive/make_stock_patch.sh once to produce them.
#
# Usage:
#   ./scripts/clara/interactive/rr python -u examples/03_vector_first_frames.py --num_envs 1 --task_id 0
#   MODE=oglite ./scripts/clara/interactive/rr python -u examples/02_evaluate.py ...
#   MODE=oglite REALM_INCREMENTAL_CONTACT_CACHE=1 ./scripts/clara/interactive/rr python ...
#
# Notes:
#   - `apptainer run`, never `exec`: the %runscript activates conda env `behavior` (python 3.11).
#     `exec` lands on the base python with no omnigibson.
#   - NEVER wrap the command in `bash -lc`. Apptainer binds $HOME by default, so a *login* shell
#     re-sources the host ~/.bashrc, which prepends /home/sedlam56/miniconda3/bin to PATH and
#     shadows the container's conda env -- you get host python 3.12 and
#     `ModuleNotFoundError: No module named 'omnigibson'`. Use `bash -c`, or just call python
#     directly. Confirmed here 2026-08-13.
#   - /tmp is bound to Lustre. The node's real /tmp is node-local and wiped; NUMBA_CACHE_DIR
#     (=/tmp/numba_cache, set by the image) must be writable and must survive.
#   - `conda run` is not involved at all here, so the --no-capture-output trap does not apply.

set -uo pipefail

# Every path comes from lib/paths.sh, derived there from ITS own location -- never hardcoded, never
# read out of the environment. Two reasons, both of which have already cost real time:
#
#   1. Worktree isolation. This script used to name the main checkout absolutely, so a worktree's
#      copy still bound the MAIN checkout at /app: edits to realm/ in the worktree had no effect on
#      the run while edits to harness scripts did (rr sets no --pwd, so the container inherits the
#      caller's cwd and resolves the script path against the worktree). Measured 2026-08-13:
#      CWD=<worktree> but realm/__init__.py=/app/... from the shared tree. Two agents' fixes were
#      tested against code they had not edited.
#   2. The profile EXPORTS REALM_ROOT and REALM_SIF naming the PRE-PORT 1.1.1 tree and image, so a
#      `${REALM_SIF:-<og391 default>}` here selects the wrong container without saying so. The full
#      account is in the header of scripts/clara/lib/paths.sh -- read it before adding a path.
#
# Sets REALM_ROOT, REALM_SIF, REALM_DATA (-> /data), REALM_APPDATA (-> /cache), REALM_LOGS
# (-> /logs), REALM_OGLITE_ROOT and REALM_STOCK_PATCH.
source "$(dirname "${BASH_SOURCE[0]}")/../lib/paths.sh"
# A failed `source` is not fatal by itself (no set -e), and $REALM_ROOT would then hold the
# value the shell profile exports -- the PRE-PORT 1.1.1 checkout -- so this run would silently
# evaluate the wrong tree. paths.sh sets REALM_PATHS_SH last and does not export it.
[ "${REALM_PATHS_SH:-}" = 1 ] || { echo "ERROR: could not source scripts/clara/lib/paths.sh" >&2; exit 1; }

# STOCK_PATCH keeps its own override: unlike the REALM_* names, nothing in the shell profile touches
# it, and MODE=stockfix is routinely pointed at a freshly built patch dir.
STOCK_PATCH=${STOCK_PATCH:-$REALM_STOCK_PATCH}
MODE=${MODE:-stock}
JOB=${SLURM_JOB_ID:-interactive}
TMPROOT=$REALM_ROOT/tmp/$JOB

[ -f "$REALM_SIF" ]  || { echo "rr: no SIF at $REALM_SIF" >&2; exit 1; }
[ -d "$REALM_DATA/behavior-1k-assets" ] || { echo "rr: no dataset at $REALM_DATA" >&2; exit 1; }
[ -d "$REALM_LOGS" ] || { echo "rr: no log dir at $REALM_LOGS" >&2; exit 1; }

OGLITE_BIND=()
case "$MODE" in
  stock)  ;;
  stockfix)
    # Bind ONE patched file over the stock package rather than the whole fork. Without it, scenes
    # other than 0 load their objects ~100 m high and the task object falls to z=0.015 -- measured
    # on this image for both Default and V-SC, and it was the ONLY thing that failed.
    [ -d "$STOCK_PATCH/omnigibson" ] || { echo "rr: no patched files under $STOCK_PATCH -- run scripts/clara/interactive/make_stock_patch.sh" >&2; exit 1; }
    # Bind each patched file individually over the stock package rather than the whole fork, so the
    # image stays stock apart from exactly these. Three files: the z-offset fix (without which every
    # scene but 0 loads its objects ~100 m high), the init-queue identity match (without which a
    # sibling scene evicts freshly-added objects and REALM has to repair it at runtime), and
    # OmniSurfaceMaterialPrim's missing preset_name default (without which such assets never load).
    OGLITE_BIND=()
    while IFS= read -r f; do
      rel=${f#"$STOCK_PATCH"/}
      OGLITE_BIND+=(--bind "$f":/behavior-src/OmniGibson/"$rel")
    done < <(find "$STOCK_PATCH/omnigibson" -name '*.py')
    ;;
  oglite)
    [ -d "$REALM_OGLITE_ROOT/omnigibson" ] || { echo "rr: no OG-lite at $REALM_OGLITE_ROOT" >&2; exit 1; }
    OGLITE_BIND=(--bind "$REALM_OGLITE_ROOT/omnigibson":/behavior-src/OmniGibson/omnigibson)
    ;;
  *) echo "rr: MODE must be stock, stockfix or oglite (got '$MODE')" >&2; exit 1 ;;
esac

# REALM_LIGHT_FIX only exists in patched OmniGibson. Under MODE=stock the image's own 3.9.1 has no
# code that reads it, so the run would silently use stock lighting while its environment claimed
# otherwise -- the one failure mode an explicit flag is supposed to prevent. Refuse instead.
# DROP THIS GUARD once the SIF is rebuilt: both build recipes now bake the two light patches in, and
# a rebuilt image honours the flag under MODE=stock like any other.
# The default is :-1 to match macros.py: now that the flag is on by default, UNSET is a request for
# 1.1.1 lighting, so unset under MODE=stock is the silent-mismatch case this guard exists to catch.
if [ "${REALM_LIGHT_FIX:-1}" != 0 ] && [ "$MODE" = stock ]; then
  echo "rr: REALM_LIGHT_FIX=${REALM_LIGHT_FIX:-1 (default)} needs MODE=oglite or MODE=stockfix -- the" >&2
  echo "    image's own OmniGibson 3.9.1 has no code that reads it, so this run would silently be" >&2
  echo "    stock-lit. Pass REALM_LIGHT_FIX=0 if stock lighting is what you actually want." >&2
  exit 1
fi

mkdir -p "$TMPROOT" "$REALM_APPDATA/appdata"

# Pass through the REALM/OG knobs only when the caller set them, so an unset var does not
# become the string "".
#
# REALM_LIGHT_FIX=1 restores OG 1.1.1's light configuration (FORCE_LIGHT_INTENSITY 150000 and no
# inputs:normalize write). ON BY DEFAULT in macros.py as of 2026-08-18, so leaving it unset here gets
# 1.1.1 lighting; pass REALM_LIGHT_FIX=0 for stock OG 3.9.1, which is bit-identical. It exists
# because 3.9.1's two changes (intensity /15, emission x1/area) cancel only at light area
# 1/15 m^2, leaving a PER-SCENE error: as shipped the per-task brightness ratio against 1.1.1 spans
# x1.03-x1.56, and with the flag on it collapses to x1.199-x1.313. Full rationale at the
# FORCE_LIGHT_INTENSITY definition in omnigibson/macros.py. Every run prints its resolved state as
# a "[REALM_LIGHT_FIX] ..." line, so grep the log rather than guessing.
#
# Needs MODE=oglite or MODE=stockfix -- plain MODE=stock runs the image's unpatched OmniGibson,
# where the variable has nothing to read it, so it is silently inert. Guarded below.
PASS_ENV=()
for v in REALM_INCREMENTAL_CONTACT_CACHE REALM_PROXIMITY_GATE REALM_GPU_DYNAMICS REALM_LIGHT_FIX OMNIGIBSON_HEADLESS; do
  if [ -n "${!v:-}" ]; then PASS_ENV+=(--env "$v=${!v}"); fi
done

exec apptainer run --userns --nv --writable-tmpfs \
  --bind "$REALM_ROOT":/app \
  --bind "$REALM_DATA":/data \
  --bind "$REALM_APPDATA":/cache \
  --bind "$REALM_LOGS":/logs \
  --bind "$TMPROOT":/tmp \
  "${OGLITE_BIND[@]}" \
  --env TMPDIR=/tmp \
  --env OMNIGIBSON_HEADLESS="${OMNIGIBSON_HEADLESS:-1}" \
  --env NVIDIA_DRIVER_CAPABILITIES=all \
  --env CUDA_VISIBLE_DEVICES=0 \
  --env PYTHONUNBUFFERED=1 \
  "${PASS_ENV[@]}" \
  "$REALM_SIF" \
  "$@"
