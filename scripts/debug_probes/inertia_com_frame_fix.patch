+_COM_LINK_FRAME_LINKS = frozenset(
+    {
+        "base_link",
+        "left_outer_knuckle",
+        "right_outer_knuckle",
+        "left_outer_finger",
+        "right_outer_finger",
+        "left_inner_finger",
+        "right_inner_finger",
+        "left_inner_knuckle",
