+
+# A NAME MATCH ALONE IS NOT ENOUGH TO SCOPE THIS.
+#
+# Eight of the names above are Robotiq-specific and effectively unique, but `base_link` is one of the
+# commonest link names in the BEHAVIOR dataset -- `/World/scene_0/breakfast_table_support/base_link`
+# and the like. Keying on the bare name would silently re-derive the CoM, and therefore the inertia
+# and the dynamics, of any such object whose collision geometry happens to sit under an intermediate
+# Xform. The new value would be the correct one, but it would be a behaviour change on objects nobody
+# has measured, and it would invalidate comparison against anything collected earlier.
+#
+# So require the link to actually belong to a Robotiq 2F-85: its parent must also carry the two
+# `*_inner_finger` links, which no BEHAVIOR object has. Structural, so it needs no robot name, no
+# prim-path substring and no config.
+_COM_LINK_FRAME_SIBLINGS = ("left_inner_finger", "right_inner_finger")
+
+
+def _is_robotiq_2f85_link(prim):
+    """True only for a link of a Robotiq 2F-85 gripper, identified by its sibling links."""
+    if prim.GetName() not in _COM_LINK_FRAME_LINKS:
+        return False
+    parent = prim.GetParent()
+    if not (parent and parent.IsValid()):
+        return False
+    return all(parent.GetChild(s).IsValid() for s in _COM_LINK_FRAME_SIBLINGS)
+
