Bootstrap: docker
From: stanfordvl/behavior:3.9.1

# Apptainer counterpart of .docker/realm_og391.Dockerfile -- keep the two in sync.
#
# Differences from the 1.1.1 realm.def this replaces:
#   - base image ships conda (env "behavior", python 3.11) instead of micromamba ("omnigibson", 3.10)
#   - OmniGibson lives at /behavior-src/OmniGibson, not /omnigibson-src, and is a PEP-660 editable install
#   - one OMNIGIBSON_DATA_PATH=/data replaces the four separate dataset/asset/key path variables
#   - the entity_prim patch is a diff instead of a whole-file copy, and a second patch is needed
#   - dm-robotics is pinned to 0.9.0 (0.10.0 requires numpy>=2, which OmniGibson 3.9.1 forbids)

%files
    realm/misc/entity_prim_og391.patch /opt/entity_prim_og391.patch
    realm/misc/usd_object_og391.patch /opt/usd_object_og391.patch
    realm/misc/scene_base_zoffset_og391.patch /opt/scene_base_zoffset_og391.patch
    realm/misc/simulator_initqueue_og391.patch /opt/simulator_initqueue_og391.patch
    realm/misc/material_prim_preset_og391.patch /opt/material_prim_preset_og391.patch
    realm/misc/xform_prim_rootlink_og391.patch /opt/xform_prim_rootlink_og391.patch
    realm/misc/entity_prim_rootlink_og391.patch /opt/entity_prim_rootlink_og391.patch
    realm/misc/light_normalize_macros_og391.patch /opt/light_normalize_macros_og391.patch
    realm/misc/light_normalize_dataset_object_og391.patch /opt/light_normalize_dataset_object_og391.patch
    .docker/og391-constraints.txt /opt/og391-constraints.txt
    packages/openpi-client /opt/openpi-client

%post
    set -e

    # Relax the OmniGibson kinematic-tree assertions that reject our custom robot USDs.
    # Fails the build loudly if a patch no longer applies to this OmniGibson version.
    patch -p1 -d /behavior-src/OmniGibson < /opt/entity_prim_og391.patch
    patch -p1 -d /behavior-src/OmniGibson < /opt/usd_object_og391.patch

    # Scene-file objects load ~100 m too high in every scene except index 0, which makes vector
    # envs unusable: measured at num_envs=4, 70 of 128 registered objects in each of scenes 1..3
    # sat at z ~ +100, INCLUDING the table the task needs, so the task object had nothing to rest
    # on and fell to z=0.015. Reproduced against this stock image on 2026-08-14: with num_envs=2,
    # scene 0 passed every check while scene 1 reported "main object left the table (z=0.015)" and
    # a distractor displaced 3.51 m. Scene 0's origin IS the world origin, which is why a single
    # env never sees this. Taken from the OG-lite fork (ef7442b) so that the vectorized eval path
    # works against stock OmniGibson without binding that fork over the image.
    patch -p1 -d /behavior-src/OmniGibson < /opt/scene_base_zoffset_og391.patch

    # Simulator._pre_remove_object pruned the GLOBAL object-init queue by object NAME. Names are
    # unique per SCENE, not per simulator, and every vector-env member is typically built from the
    # same config, so removing one member's "corkscrew" popped a SIBLING member's freshly added one
    # off the queue; it stayed on the stage and in the registry but was never initialised, and the
    # scene later died in dump_state() or inside play() itself. Matching on identity is strictly
    # narrower and always the correct entry. REALM carries a runtime repair for this
    # (RealmVectorEnvironment._repair_init_queue) precisely because the image lacked the fix --
    # with this patch that repair reports zero, which is how you can tell the image has it.
    patch -p1 -d /behavior-src/OmniGibson < /opt/simulator_initqueue_og391.patch

    # OmniSurfaceMaterialPrim.__init__ required preset_name positionally although its own docstring
    # and both of its accessors are written for preset_name=None, and MaterialPrim.get_material has
    # no preset to pass when it infers the subclass from an existing prim. Any asset whose material
    # resolves to OmniSurface therefore failed to load at all.
    patch -p1 -d /behavior-src/OmniGibson < /opt/material_prim_preset_og391.patch

    # An articulation was placed by whichever prim happened to be read rather than by its ROOT LINK.
    # XFormPrim._set_xform_properties read the pose through the VIRTUAL self.get_position_orientation()
    # -- EntityPrim overrides it to return the root link's pose -- and wrote it back through the pinned
    # XFormPrim.set_position_orientation, which authors the ENTITY prim's xformOps; and
    # EntityPrim.set_position_orientation's stopped-sim branch simply ASSERTED that the two coincide.
    # Both hold for every BEHAVIOR dataset asset, whose base_link sits at the entity origin, and for no
    # DCC export that does not: REALM's custom_assets/impact_drawer/usd/cabinet.usd has base_link at
    # Ry(180) + 4 cm, so open_drawer/close_drawer could not load at all. Taken from the OG-lite fork
    # (7c59ed5). Both hunks are no-ops when the root link IS at the entity origin, so no other asset's
    # placement moves. NOTE entity_prim.py is patched twice -- this one after the root-link relaxation
    # above, which touches an unrelated part of the file.
    patch -p1 -d /behavior-src/OmniGibson < /opt/xform_prim_rootlink_og391.patch
    patch -p1 -d /behavior-src/OmniGibson < /opt/entity_prim_rootlink_og391.patch

    # REALM_LIGHT_FIX -- ON BY DEFAULT as of 2026-08-18. AN IMAGE BUILT FROM THIS RECIPE IS
    # 1.1.1-LIT UNLESS A RUN SETS REALM_LIGHT_FIX=0. This comment used to say the patches were
    # opt-in and baking them in "changes nothing"; that stopped being true when the default flipped,
    # and it is exactly the sentence that would let a rebuild change every recorded number silently.
    #
    # Two 3.9.1 changes cancel each other and leave a PER-SCENE lighting error:
    # FORCE_LIGHT_INTENSITY went 150000 -> 10000 while dataset_object.py started also writing
    # inputs:normalize = True, which divides emission by light AREA. The two cancel EXACTLY at
    # area = 1/15 m^2, so scenes whose lights sit near that already match 1.1.1 (push_switch x1.03)
    # and scenes with smaller lights are too bright (rotate_mug x1.56). Setting the flag restores
    # 1.1.1's exact configuration; that does not MATCH 1.1.1 (a uniform ~13-33% excess remains) but
    # it tightens the per-task spread from 0.551 to 0.201 over the 6 comparable tasks -- 2.74x --
    # turning a per-scene domain shift into one global gain. (SIX tasks, corrected 2026-08-19: the
    # published 7-task figure of 2.2x included open_drawer, whose cabinet reached no camera until
    # 8598e59, which landed 90 min AFTER the table was written. Both corrections in full at the
    # FORCE_LIGHT_INTENSITY definition in omnigibson/macros.py.) ONE change in two files -- 150000 WITH
    # normalize=True is ~35x too bright, so they must never be applied separately;
    # dataset_object.py asserts macros.py carries its half.
    patch -p1 -d /behavior-src/OmniGibson < /opt/light_normalize_macros_og391.patch
    patch -p1 -d /behavior-src/OmniGibson < /opt/light_normalize_dataset_object_og391.patch

    rm /opt/entity_prim_og391.patch /opt/usd_object_og391.patch /opt/scene_base_zoffset_og391.patch \
       /opt/simulator_initqueue_og391.patch /opt/material_prim_preset_og391.patch \
       /opt/xform_prim_rootlink_og391.patch /opt/entity_prim_rootlink_og391.patch \
       /opt/light_normalize_macros_og391.patch /opt/light_normalize_dataset_object_og391.patch

    CONDA_PIP=/opt/conda/envs/behavior/bin/pip

    # dm_control / dm_robotics stack. Pinned to 0.9.0 because 0.10.0 requires numpy>=2,
    # which OmniGibson 3.9.1 forbids (numpy<2.0.0,>=1.23.5). 0.9.0 pulls dm-control 1.0.15.
    $CONDA_PIP install --no-cache-dir -c /opt/og391-constraints.txt \
        dm-robotics-transformations==0.9.0 \
        dm-robotics-geometry==0.9.0 \
        dm-robotics-controllers==0.9.0

    $CONDA_PIP install --no-cache-dir -c /opt/og391-constraints.txt \
        dm-robotics-moma==0.9.0 \
        dm-robotics-manipulation==0.9.0

    # Remaining REALM runtime deps not present in the base image.
    $CONDA_PIP install --no-cache-dir -c /opt/og391-constraints.txt \
        wandb moviepy openai fastparquet

    $CONDA_PIP install --no-cache-dir -c /opt/og391-constraints.txt /opt/openpi-client

%environment
    # The base image's OMNIGIBSON_DATA_PATH=/data and OMNIGIBSON_APPDATA_PATH=/cache/appdata come
    # through from the Docker layer; only our own source tree has to be added.
    export PYTHONPATH=/app:$PYTHONPATH
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    # omnigibson.utils.transform_utils_np decorates with @jit(..., cache=True), and numba writes
    # that cache next to the source file. A sif is read-only, so `import omnigibson` dies with
    # "cannot cache function '_quat_multiply': no locator available" unless the cache is redirected
    # somewhere writable. This never shows up under Docker, where the layer is writable.
    export NUMBA_CACHE_DIR="${NUMBA_CACHE_DIR:-/tmp/numba_cache}"

%runscript
    # Docker's ENTRYPOINT (/entrypoint.sh, which activates the conda env) is not honoured by
    # Apptainer, so the environment is activated here instead.
    . /opt/conda/etc/profile.d/conda.sh
    conda activate behavior
    if [ $# -eq 0 ]; then
        exec /bin/bash --login
    else
        exec "$@"
    fi

%test
    # Without this, a failing check below is masked by the later commands' exit status and the
    # build reports success anyway.
    set -e
    . /opt/conda/etc/profile.d/conda.sh
    conda activate behavior
    # %environment is not applied during %test, so the numba cache redirect is repeated here.
    export NUMBA_CACHE_DIR=/tmp/numba_cache
    # NOTE: omnigibson deliberately is NOT imported here. `omnigibson.macros` asserts at import time
    # that gm.DATA_PATH exists, and nothing is bound to /data during a build, so importing it can
    # never succeed at this point. Its presence is checked via installed metadata instead; a real
    # import check needs the dataset bound, e.g.
    #     apptainer test --bind <datasets>:/data realm_og391.sif
    python - <<'PY'
from importlib.metadata import version
import dm_control, dm_robotics.moma, openpi_client, wandb, moviepy, fastparquet, numpy, torch
assert version("omnigibson") == "3.9.1", version("omnigibson")
assert numpy.__version__.startswith("1.26"), numpy.__version__
print("omnigibson", version("omnigibson"), "| numpy", numpy.__version__, "| torch", torch.__version__)
print("dm_control", version("dm-control"), "| dm-robotics-moma", version("dm-robotics-moma"))
PY
    # The two REALM patches must be baked in, or custom robot USDs fail their kinematic-tree checks.
    grep -q "REALM: relaxed" /behavior-src/OmniGibson/omnigibson/prims/entity_prim.py
    grep -q "REALM: relaxed" /behavior-src/OmniGibson/omnigibson/objects/usd_object.py
    # And the z-offset fix, without which every scene except 0 loads its objects 100 m high.
    grep -q "Re-apply the object poses now that the scene prim is at its final position" \
        /behavior-src/OmniGibson/omnigibson/scenes/scene_base.py
    grep -q "initialize_obj is obj" /behavior-src/OmniGibson/omnigibson/simulator.py
    grep -q "preset_name=None" /behavior-src/OmniGibson/omnigibson/prims/material_prim.py
    grep -q "current_orientation = XFormPrim.get_position_orientation(self)" \
        /behavior-src/OmniGibson/omnigibson/prims/xform_prim.py
    grep -q "root_local = T.pose2mat(get_local_pose(self.root_link.prim_path))" \
        /behavior-src/OmniGibson/omnigibson/prims/entity_prim.py
    # Both halves of the opt-in light fix. Half of it is worse than none of it.
    grep -q "gm.REALM_LIGHT_FIX = " /behavior-src/OmniGibson/omnigibson/macros.py
    grep -q "if not light_fix:" /behavior-src/OmniGibson/omnigibson/objects/dataset_object.py
    echo "REALM patches present"
