+# Compiled form of gm.CONTACT_REPORTING_PATTERNS, rebuilt whenever the macro changes.
+_CONTACT_REPORTING_PATTERNS_SRC = None
+_CONTACT_REPORTING_REGEXES = None
+
+
+def _contact_reporting_wanted(prim_path):
+    """
+    Returns:
+        bool: Whether @prim_path should have contact reporting enabled, per gm.CONTACT_REPORTING_PATTERNS.
+            Always True when the macro is unset, which is the upstream behavior.
+    """
+    global _CONTACT_REPORTING_PATTERNS_SRC, _CONTACT_REPORTING_REGEXES
+
+    patterns = gm.CONTACT_REPORTING_PATTERNS
+    if patterns is None:
+        return True
+
+    # Recompile only when the macro itself changed
+    if patterns is not _CONTACT_REPORTING_PATTERNS_SRC:
+        _CONTACT_REPORTING_PATTERNS_SRC = patterns
+        _CONTACT_REPORTING_REGEXES = [re.compile(pattern) for pattern in patterns]
+
+    return any(regex.search(prim_path) for regex in _CONTACT_REPORTING_REGEXES)
+
+
