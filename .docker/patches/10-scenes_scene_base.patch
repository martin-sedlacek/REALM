--- a/omnigibson/scenes/scene_base.py
+++ b/omnigibson/scenes/scene_base.py
@@ -401,6 +401,31 @@
             identity_quat = th.tensor([0.0, 0.0, 0.0, 1.0])
             self._scene_prim.set_position_orientation(position=scene_position, orientation=identity_quat)
             new_scene_edge = last_scene_edge + scene_margin + (aabb_max[0] - aabb_min[0])
+
+            # Re-apply the object poses now that the scene prim is at its final position.
+            #
+            # The loop above sets each pose with the default frame="world" while the prim is still
+            # parked at initial_scene_prim_z_offset, so the world target gets baked into local
+            # coordinates against the parked transform: local_z = intended_z - offset. Moving the
+            # prim to z=0 then carries every object with it, leaving all of them exactly -offset
+            # (i.e. +100 m) too high. The prebuilt scene structure keeps its own authored local
+            # transform and lands correctly, so the visible result is a room with its furniture
+            # missing rather than a scene that is uniformly displaced.
+            #
+            # Measured against REALM at num_envs=4: 70 of 128 registered objects in each of
+            # scenes 1..3 sat at z ~ +100, including the breakfast table the task needs. REALM then
+            # pinned that table with a FixedJoint at the lifted pose, which no later reset can undo.
+            #
+            # frame="scene" is not usable here: it routes through
+            # convert_scene_relative_pose_to_world, which reads _pose_info, and _pose_info is only
+            # assigned by Scene.load() after this method returns. So offset by scene_position
+            # explicitly -- local then works out to exactly the authored pose.
+            for obj_name, obj in self._init_objs.items():
+                obj.set_position_orientation(
+                    position=th.as_tensor(self._init_state[obj_name]["root_link"]["pos"], dtype=th.float32)
+                    + scene_position,
+                    orientation=self._init_state[obj_name]["root_link"]["ori"],
+                )
         else:
             scene_position = th.zeros(3)
             aabb_min, aabb_max = lazy.omni.usd.get_context().compute_path_world_bounding_box(scene_absolute_path)
