+# Cache of proximity-gated objects, keyed weakly by scene so entries die with their scene. Keyed by
+# the scene object rather than scene.idx (which asserts before the scene is loaded) or id(scene)
+# (which CPython may reuse after a scene is freed, silently handing a new scene a stale gate).
+# Recomputed whenever the contact view is rebuilt (see RigidContactAPI.initialize_view), not per step.
+_PROXIMITY_GATE_CACHE = weakref.WeakKeyDictionary()
+
+
+def clear_proximity_gate_cache():
+    """
+    Drops the cached proximity-gate membership so it is recomputed on next use. Called whenever the
+    set of objects or their poses may have changed materially (scene load, handle rebuild).
+    """
+    _PROXIMITY_GATE_CACHE.clear()
+
+
+def compute_proximity_gated_objects(scene, force_recompute=False):
+    """
+    Objects in @scene that are far enough from every robot to be excluded from per-step bookkeeping.
+
+    Distance is measured between axis-aligned bounding boxes, not origins, so a large object counts
+    as near if any part of it is within reach. Robots themselves are never gated.
+
+    Args:
+        scene (Scene): Scene to evaluate
+        force_recompute (bool): If True, ignore any cached result
+
+    Returns:
+        set: Objects that lie outside gm.PROXIMITY_GATE_RADIUS of every robot. Empty when the gate is
+            disabled or the scene has no robots.
+    """
+    if not gm.PROXIMITY_GATE_ENABLED:
+        return set()
+
+    key = scene
+    if not force_recompute and key in _PROXIMITY_GATE_CACHE:
+        return _PROXIMITY_GATE_CACHE[key]
+
+    robots = list(scene.robots)
+    if not robots:
+        # Nothing to be near; leave everything active rather than silently freezing the whole scene.
+        _PROXIMITY_GATE_CACHE[key] = set()
+        return _PROXIMITY_GATE_CACHE[key]
+
+    radius = gm.PROXIMITY_GATE_RADIUS
+    robot_aabbs = []
+    for robot in robots:
+        try:
+            robot_aabbs.append(robot.aabb)
+        except Exception:
+            # A robot whose AABB cannot be read yet should not cause the whole scene to be gated
+            _PROXIMITY_GATE_CACHE[key] = set()
+            return _PROXIMITY_GATE_CACHE[key]
+
+    gated = set()
+    for obj in scene.objects:
+        if obj in robots:
+            continue
+        try:
+            obj_lower, obj_upper = obj.aabb
+        except Exception:
+            # If we cannot place it, keep it active -- gating is an optimization, never a correctness
+            # requirement, so the safe failure direction is to do the work.
+            continue
+        near = False
+        for robot_lower, robot_upper in robot_aabbs:
+            # Axis-aligned box-to-box gap, zero on any axis where the boxes overlap
+            gap = th.clamp(robot_lower - obj_upper, min=0.0) + th.clamp(obj_lower - robot_upper, min=0.0)
+            if th.linalg.norm(gap).item() <= radius:
+                near = True
+                break
+        if not near:
+            gated.add(obj)
+
+    if gated:
+        log.info(
+            f"Proximity gate: {len(gated)}/{len(scene.objects)} objects beyond {radius}m of any robot "
+            f"are excluded from per-step contact and state updates. Set gm.PROXIMITY_GATE_ENABLED = "
+            f"False to disable (required for mobile manipulation)."
+        )
+    _PROXIMITY_GATE_CACHE[key] = gated
+    return gated
