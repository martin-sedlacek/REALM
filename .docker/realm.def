Bootstrap: docker
From: stanfordvl/behavior:3.9.1

# Apptainer counterpart of .docker/realm.Dockerfile -- keep the two in sync.
#
# Differences from the 1.1.1 realm.def this replaces:
#   - base image ships conda (env "behavior", python 3.11) instead of micromamba ("omnigibson", 3.10)
#   - OmniGibson lives at /behavior-src/OmniGibson, not /omnigibson-src, and is a PEP-660 editable install
#   - one OMNIGIBSON_DATA_PATH=/data replaces the four separate dataset/asset/key path variables
#   - dm-robotics is pinned to 0.9.0 (0.10.0 requires numpy>=2, which OmniGibson 3.9.1 forbids)
#
# THIS BUILD IS SELF-CONTAINED. It needs only this repository: no sibling OG-lite checkout, no
# staging script to run first, and no runtime bind. .docker/patches/ holds the image's complete
# delta from stock 3.9.1 -- read .docker/patches/PROVENANCE for how it was derived and how to
# regenerate it.

# NOTE: %files below takes bare `src dest` pairs -- apptainer parses a leading '#' as a source
# PATH, not a comment, so explanations live outside the section.
%files
    .docker/patches /opt/realm-patches
    .docker/constraints.txt /opt/realm-constraints.txt
    packages/openpi-client /opt/openpi-client
    packages/robometer-client /opt/robometer-client

%post
    set -e

    # ==========================================================================================
    # APPLY REALM'S DELTA FROM STOCK OMNIGIBSON 3.9.1.
    #
    # Twelve patches, applied in filename order, then verified two ways:
    #   MANIFEST.sha256   every patched file hashes to the tree the patches were generated from.
    #                     This is the drift guard: a patch that applies with fuzz, or a base image
    #                     whose content moved under us, changes a hash and fails the build.
    #   nine grep guards  the semantic changes, by name, so a failure says WHICH behaviour is gone
    #                     rather than only that a hash moved. Listed in %test as well.
    #
    # A future base image's upstream fixes to these twelve files will make a patch FAIL TO APPLY.
    # That is deliberate: the build stops rather than silently discarding an upstream fix. Rebase
    # the patch and regenerate the manifest -- see PROVENANCE.
    #
    # WHAT THE TWELVE CARRY, in one line each: render-on-demand plumbing (envs/env_base,
    # envs/vec_env_base); the perf switches and REALM_LIGHT_FIX (macros); the normalize gate that is
    # REALM_LIGHT_FIX's other half (objects/dataset_object); relaxed kinematic-tree assertions for
    # REALM's custom robot USDs (objects/usd_object, prims/entity_prim); placing an articulation by
    # its ROOT LINK, without which impact_drawer's base_link at Ry(180) + 4 cm stopped the drawer
    # tasks loading (prims/entity_prim, prims/xform_prim); OmniSurfaceMaterialPrim's preset_name
    # default, without which any asset resolving to OmniSurface failed to load (prims/material_prim);
    # the incremental contact cache (prims/rigid_prim); the scene z-offset, without which scene-file
    # objects load ~100 m high in every scene but 0 and the vectorized path is unusable
    # (scenes/scene_base); the object-init queue matched by identity instead of by NAME, so removing
    # one vector member's object no longer evicts a sibling's uninitialised one, plus the proximity
    # gate (simulator); and the descriptor-pool raise (utils/usd_utils).
    #
    # REALM_LIGHT_FIX IS ON BY DEFAULT, so THIS IMAGE IS 1.1.1-LIT unless a run sets
    # REALM_LIGHT_FIX=0. 3.9.1 took FORCE_LIGHT_INTENSITY 150000 -> 10000 while also writing
    # inputs:normalize=True; the two cancel exactly at light area 1/15 m^2, leaving a PER-SCENE
    # error. Restoring 1.1.1's configuration tightens the per-task spread 0.551 -> 0.201 over the 6
    # comparable tasks (2.74x), turning a per-scene domain shift into one global gain. macros.py
    # prints the resolved state at import, so no run is ambiguous about which lighting it used.
    cd /behavior-src/OmniGibson
    for p in /opt/realm-patches/*.patch; do
        echo "--- applying $(basename "$p")"
        patch -p1 --forward --batch --no-backup-if-mismatch < "$p"
    done
    sha256sum -c /opt/realm-patches/MANIFEST.sha256
    cp /opt/realm-patches/PROVENANCE /behavior-src/OmniGibson/REALM_PATCH_PROVENANCE
    # No stale bytecode: a .pyc that outlives the source it was compiled from is a miserable bug to
    # chase inside a container.
    find /behavior-src/OmniGibson/omnigibson -name '__pycache__' -type d -prune -exec rm -rf {} + || true
    echo "--- REALM patch set applied and hash-verified ---"
    # ==========================================================================================

    CONDA_PIP=/opt/conda/envs/behavior/bin/pip

    # dm_control / dm_robotics stack. Pinned to 0.9.0 because 0.10.0 requires numpy>=2,
    # which OmniGibson 3.9.1 forbids (numpy<2.0.0,>=1.23.5). 0.9.0 pulls dm-control 1.0.15.
    $CONDA_PIP install --no-cache-dir -c /opt/realm-constraints.txt \
        dm-robotics-transformations==0.9.0 \
        dm-robotics-geometry==0.9.0 \
        dm-robotics-controllers==0.9.0

    $CONDA_PIP install --no-cache-dir -c /opt/realm-constraints.txt \
        dm-robotics-moma==0.9.0 \
        dm-robotics-manipulation==0.9.0

    # Remaining REALM runtime deps not present in the base image.
    $CONDA_PIP install --no-cache-dir -c /opt/realm-constraints.txt \
        wandb moviepy openai fastparquet

    $CONDA_PIP install --no-cache-dir -c /opt/realm-constraints.txt /opt/openpi-client

    # Robometer reward-model CLIENT only (numpy + requests, both already pinned). The model server is
    # packages/robometer, run in its own env via scripts/run_robometer_server.sh -- its torch 2.8 /
    # transformers 4.57 / python==3.10 requirements cannot be installed here. Same arrangement as openpi.
    $CONDA_PIP install --no-cache-dir -c /opt/realm-constraints.txt /opt/robometer-client

%environment
    # The base image's OMNIGIBSON_DATA_PATH=/data and OMNIGIBSON_APPDATA_PATH=/cache/appdata come
    # through from the Docker layer; only our own source tree has to be added.
    export PYTHONPATH=/app:$PYTHONPATH
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    # omnigibson.utils.transform_utils_np decorates with @jit(..., cache=True), and numba writes
    # that cache next to the source file. A sif is read-only, so `import omnigibson` dies with
    # "cannot cache function '_quat_multiply': no locator available" unless the cache is redirected
    # somewhere writable. This never shows up under Docker, where the layer is writable.
    export NUMBA_CACHE_DIR="${NUMBA_CACHE_DIR:-/tmp/numba_cache}"

%runscript
    # Docker's ENTRYPOINT (/entrypoint.sh, which activates the conda env) is not honoured by
    # Apptainer, so the environment is activated here instead.
    . /opt/conda/etc/profile.d/conda.sh
    conda activate behavior
    if [ $# -eq 0 ]; then
        exec /bin/bash --login
    else
        exec "$@"
    fi

%test
    # Without this, a failing check below is masked by the later commands' exit status and the
    # build reports success anyway.
    set -e
    . /opt/conda/etc/profile.d/conda.sh
    conda activate behavior
    # %environment is not applied during %test, so the numba cache redirect is repeated here.
    export NUMBA_CACHE_DIR=/tmp/numba_cache
    # NOTE: omnigibson deliberately is NOT imported here. `omnigibson.macros` asserts at import time
    # that gm.DATA_PATH exists, and nothing is bound to /data during a build, so importing it can
    # never succeed at this point. Its presence is checked via installed metadata instead; a real
    # import check needs the dataset bound, e.g.
    #     apptainer test --bind <datasets>:/data realm.sif
    python - <<'PY'
from importlib.metadata import version
import dm_control, dm_robotics.moma, openpi_client, robometer_client, wandb, moviepy, fastparquet, numpy, torch
assert version("omnigibson") == "3.9.1", version("omnigibson")
assert numpy.__version__.startswith("1.26"), numpy.__version__
print("omnigibson", version("omnigibson"), "| numpy", numpy.__version__, "| torch", torch.__version__)
print("dm_control", version("dm-control"), "| dm-robotics-moma", version("dm-robotics-moma"))
print("openpi-client", version("openpi-client"), "| robometer-client", version("robometer-client"))
PY
    # The patched tree still hashes to what the patch set was generated from.
    ( cd /behavior-src/OmniGibson && sha256sum -c /opt/realm-patches/MANIFEST.sha256 )
    # The nine semantic changes, by name, so a failure says which behaviour is missing.
    # The two REALM patches without which custom robot USDs fail their kinematic-tree checks.
    grep -q "REALM: relaxed" /behavior-src/OmniGibson/omnigibson/prims/entity_prim.py
    grep -q "REALM: relaxed" /behavior-src/OmniGibson/omnigibson/objects/usd_object.py
    # And the z-offset fix, without which every scene except 0 loads its objects 100 m high.
    grep -q "Re-apply the object poses now that the scene prim is at its final position" \
        /behavior-src/OmniGibson/omnigibson/scenes/scene_base.py
    grep -q "initialize_obj is obj" /behavior-src/OmniGibson/omnigibson/simulator.py
    grep -q "preset_name=None" /behavior-src/OmniGibson/omnigibson/prims/material_prim.py
    grep -q "current_orientation = XFormPrim.get_position_orientation(self)" \
        /behavior-src/OmniGibson/omnigibson/prims/xform_prim.py
    grep -q "root_local = T.pose2mat(get_local_pose(self.root_link.prim_path))" \
        /behavior-src/OmniGibson/omnigibson/prims/entity_prim.py
    # Both halves of the light fix. Half of it is worse than none of it.
    grep -q "gm.REALM_LIGHT_FIX = " /behavior-src/OmniGibson/omnigibson/macros.py
    grep -q "if not light_fix:" /behavior-src/OmniGibson/omnigibson/objects/dataset_object.py
    # The perf switches REALM sets in realm/sim_config.py must exist to be settable.
    for m in ENABLE_VISUAL_UPDATES OBJECT_STATE_UPDATE_WHITELIST INCREMENTAL_CONTACT_CACHE \
             PROXIMITY_GATE_ENABLED RENDER_ON_STEP; do
        grep -q "gm.$m" /behavior-src/OmniGibson/omnigibson/macros.py || { echo "missing gm.$m" >&2; exit 1; }
    done
    echo "REALM patch set present and verified"
